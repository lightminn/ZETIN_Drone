{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "table",
            "message": "Use <DataTable> from the design system instead of <table>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/AccentTab/**",
              "components/general/BulletList/**",
              "components/general/ChapterSlide/**",
              "components/general/ContentSlide/**",
              "components/general/DataTable/**",
              "components/general/DiagonalPanel/**",
              "components/general/FigureFrame/**",
              "components/general/Slide/**",
              "components/general/StatCard/**",
              "components/general/TitleSlide/**",
              "components/general/TocSlide/**",
              "components/general/UosLogo/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans CJK KR))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans CJK KR."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|className|style|key|ref|className|style|children)$/]",
        "message": "<AccentTab> doesn't accept that prop. Declared props: size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentTab'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|sm)$/]",
        "message": "<AccentTab> size must be one of 'lg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|marker|className|style|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, marker, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute[name.name='marker'] > Literal[value!=/^(?:number|dot|dash)$/]",
        "message": "<BulletList> marker must be one of 'number' | 'dot' | 'dash'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|chapterNo|className|style|key|ref|className|style|children)$/]",
        "message": "<ChapterSlide> doesn't accept that prop. Declared props: title, chapterNo, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|variant|className|style|key|ref|className|style|children)$/]",
        "message": "<ContentSlide> doesn't accept that prop. Declared props: title, children, variant, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentSlide'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|placeholder)$/]",
        "message": "<ContentSlide> variant must be one of 'plain' | 'placeholder'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|align|className|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, align, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagonalPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|style|key|ref|className|style|children)$/]",
        "message": "<DiagonalPanel> doesn't accept that prop. Declared props: children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:caption|children|ratio|className|style|key|ref|className|style|children)$/]",
        "message": "<FigureFrame> doesn't accept that prop. Declared props: caption, children, ratio, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute > JSXIdentifier[name!=/^(?:background|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Slide> doesn't accept that prop. Declared props: background, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute[name.name='background'] > Literal[value!=/^(?:white|blue)$/]",
        "message": "<Slide> background must be one of 'white' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|caption|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, caption, tone, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|neutral)$/]",
        "message": "<StatCard> tone must be one of 'blue' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|subtitle|showLogo|className|style|key|ref|className|style|children)$/]",
        "message": "<TitleSlide> doesn't accept that prop. Declared props: title, date, subtitle, showLogo, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TocSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|className|style|key|ref|className|style|children)$/]",
        "message": "<TocSlide> doesn't accept that prop. Declared props: label, items, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UosLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|className|style|key|ref|className|style|children)$/]",
        "message": "<UosLogo> doesn't accept that prop. Declared props: size, variant, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UosLogo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:white|color)$/]",
        "message": "<UosLogo> variant must be one of 'white' | 'color'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
